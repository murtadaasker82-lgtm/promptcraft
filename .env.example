# انسخ هذا الملف إلى .env ثم عدّل القيم
#   cp .env.example .env     (لينكس/ماك)
#   copy .env.example .env   (ويندوز)

# ======
# Web
# ======
APP_NAME=PromptCraft
DEBUG=false

# ======
# الأمان
# ======
# مفتاح سري لتوقيع الكوكيز — غيّره إلزاميًا في الإنتاج
# ولّد مفتاحًا عشوائيًا بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me

# اسم كوكي الجلسة
SESSION_COOKIE_NAME=session_token

# مدة الجلسة بالأيام
SESSION_TTL_DAYS=30

# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ======
# قاعدة البيانات
# ======
DATABASE_URL=sqlite:///./data/promptcraft.db
DB_ECHO=false

# =========================
# OpenAI — التفريغ الصوتي
# =========================
# المفتاح من: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# نموذج التفريغ
WHISPER_MODEL=whisper-1

# وضع التجربة: true = نص وهمي بدون اتصال (للاختبار بدون مفتاح)
WHISPER_MOCK=false

# ===================
# الرفع الصوتي
# ===================
# الحد الأقصى لحجم الملف (حد Whisper API هو 25)
MAX_UPLOAD_MB=25
