# انسخ هذا الملف إلى .env ثم عدّل القيم
#   cp .env.example .env     (لينكس/ماك)
#   copy .env.example .env   (ويندوز)

# ======
# Web
# ======
APP_NAME=PromptCraft
DEBUG=false

# ======
# الأمان
# ======
# مفتاح سري لتوقيع الكوكيز — غيّره إلزاميًا في الإنتاج
# ولّد مفتاحًا عشوائيًا بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me

# اسم كوكي الجلسة
SESSION_COOKIE_NAME=session_token

# مدة الجلسة بالأيام
SESSION_TTL_DAYS=30

# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ======
# قاعدة البيانات
# ======
DATABASE_URL=sqlite:///./data/promptcraft.db
DB_ECHO=false

# المصدر الوحيد لقاعدة البيانات. للتطوير المحلي اتركه كما هو.
# في الإنتاج (Render) استبدله بقاعدة Turso السحابية، والتوكن جزء
# من الرابط (أسلوب libSQL الرسمي):
#   DATABASE_URL=libsql://<db>.turso.io?authToken=<token>
# DATABASE_URL=sqlite:///./data/promptcraft.db

# =========================
# OpenAI — التفريغ الصوتي
# =========================
# المفتاح من: https://platform.openai.com/api-keys
# اتركه فارغًا إن كنت تستخدم WHISPER_MOCK=true فقط
OPENAI_API_KEY=

# نموذج التفريغ
WHISPER_MODEL=whisper-1

# وضع تجربة التفريغ: true = نص وهمي بدون اتصال (للاختبار بدون مفتاح)
# اجعله false لتشغيل التفريغ الحقيقي
WHISPER_MOCK=true

# ==================================
# Groq — هندسة البرومبتات
# ==================================
# المفتاح من: https://console.groq.com/keys
# الطبقة المجانية تكفي ولا تحتاج رصيدًا مُحمَّلًا.
GROQ_API_KEY=

# النموذج المستخدم لتوليد البرومبت.
# الخيارات الشائعة (القائمة الكاملة: https://console.groq.com/docs/models):
#   llama-3.1-8b-instant     — الأسرع، مناسب للمهام القصيرة
#   llama-3.3-70b-versatile  — الأقوى في الطبقة المجانية، جودة كتابة عربية أفضل
GROQ_MODEL=llama-3.1-8b-instant

# سلسلة احتياطية تُجرَّب بالترتيب عند فشل الأساسي بـ 404 أو 429 أو 503.
# الصيغة JSON مصفوفة، والعميل يتخطّى الموديل الميت تلقائيًا.
GROQ_MODELS_FALLBACK=[]

# نقطة النهاية (OpenAI-compatible) — لا تغيّرها إلا بوابة بديلة
GROQ_BASE_URL=https://api.groq.com/openai/v1

# مهلة الاستجابة بالثواني — حد أعلى حتى لا تتعلّق الواجهة
GROQ_TIMEOUT=60

# أقصى عدد رموز في مخرج النموذج — يقلّل زمن الاستجابة وحجم الرد
PROMPT_MAX_TOKENS=800

# ذاكرة مؤقتة للنتائج: نفس الطلب خلال PROMPT_CACHE_TTL يُردّ فورًا بلا استدعاء النموذج
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_SIZE=50
PROMPT_CACHE_TTL=3600

# ==============================
# النسخ الاحتياطي
# ==============================
# نسخة مؤرّخة من data/promptcraft.db عند كل إقلاع، في data/backups/
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=7

# وضع تجربة توليد البرومبت: true = برومبت قالبي بدون اتصال (للاختبار بدون مفتاح)
# اجعله false لتشغيل التوليد الحقيقي عبر Groq
PROMPT_MOCK=false

# ===================
# الرفع الصوتي
# ===================
# الحد الأقصى لحجم الملف (حد Whisper API هو 25)
MAX_UPLOAD_MB=25
