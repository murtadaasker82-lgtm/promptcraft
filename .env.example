# انسخ هذا الملف إلى .env ثم عدّل القيم
#   cp .env.example .env     (لينكس/ماك)
#   copy .env.example .env   (ويندوز)

# ======
# Web
# ======
APP_NAME=PromptCraft
DEBUG=false

# ======
# الأمان
# ======
# مفتاح سري لتوقيع الكوكيز — غيّره إلزاميًا في الإنتاج
# ولّد مفتاحًا عشوائيًا بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me

# اسم كوكي الجلسة
SESSION_COOKIE_NAME=session_token

# مدة الجلسة بالأيام
SESSION_TTL_DAYS=30

# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ======
# قاعدة البيانات
# ======
DATABASE_URL=sqlite:///./data/promptcraft.db
DB_ECHO=false

# =========================
# OpenAI — التفريغ الصوتي
# =========================
# المفتاح من: https://platform.openai.com/api-keys
# اتركه فارغًا إن كنت تستخدم WHISPER_MOCK=true فقط
OPENAI_API_KEY=

# نموذج التفريغ
WHISPER_MODEL=whisper-1

# وضع تجربة التفريغ: true = نص وهمي بدون اتصال (للاختبار بدون مفتاح)
# اجعله false لتشغيل التفريغ الحقيقي
WHISPER_MOCK=true

# ==============================
# OpenRouter — هندسة البرومبتات
# ==============================
# المفتاح من: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# النموذج المستخدم لتوليد البرومبت.
# الافتراضي مجاني: nvidia/nemotron-3-super-120b-a12b:free
# بدائل مجانية أخرى: google/gemma-4-31b-it:free، liquid/lfm-2.5-2.6b:free
# بدائل مدفوعة: anthropic/claude-sonnet-4، openai/gpt-4o-mini
# ملاحظة: قائمة النماذج تتغير باستمرار — راجع https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# نماذج احتياطية تُجرَّب بالترتيب عند فشل الأساسي بـ 429 أو 503 أو 404.
# الصيغة JSON مصفوفة — والتطبيق يتخطى النموذج غير الموجود أو المزدحم تلقائيًا.
OPENROUTER_MODELS_FALLBACK=["qwen/qwen-2.5-7b-instruct:free","google/gemini-2.0-flash-exp:free","apodex/apodex-1.1-mini:free"]

# نقطة النهاية (OpenAI-compatible) — لا تغيّرها إلا لو استخدمت بوابة بديلة
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ترويسات تعرّف التطبيق لإحصاءات OpenRouter
OPENROUTER_HTTP_REFERER=https://promptcraft.app
OPENROUTER_APP_TITLE=PromptCraft

# مهلة الاستجابة بالثواني — حد أعلى حتى لا تتعلّق الواجهة
OPENROUTER_TIMEOUT=60

# أقصى عدد رموز في مخرج النموذج — يقلّل زمن الاستجابة وحجم الرد
PROMPT_MAX_TOKENS=800

# ذاكرة مؤقتة للنتائج: نفس الطلب خلال PROMPT_CACHE_TTL يُردّ فورًا بلا استدعاء النموذج
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_SIZE=50
PROMPT_CACHE_TTL=3600

# وضع تجربة توليد البرومبت: true = برومبت قالبي بدون اتصال (للاختبار بدون مفتاح)
# اجعله false لتشغيل التوليد الحقيقي عبر OpenRouter
PROMPT_MOCK=false

# ===================
# الرفع الصوتي
# ===================
# الحد الأقصى لحجم الملف (حد Whisper API هو 25)
MAX_UPLOAD_MB=25
